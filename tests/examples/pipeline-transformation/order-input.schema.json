{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Order Input Schema",
  "description": "Schema for raw order data input to pipeline",
  "type": "object",
  "properties": {
    "orderId": {
      "type": "string",
      "description": "Unique order identifier"
    },
    "customerId": {
      "type": "string",
      "description": "Customer identifier"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "price": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": ["productId", "quantity", "price"]
      },
      "minItems": 1
    },
    "orderDate": {
      "type": "string",
      "format": "date-time",
      "description": "Order creation timestamp"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "confirmed", "shipped", "delivered"]
    }
  },
  "required": ["orderId", "customerId", "items", "orderDate", "status"]
}